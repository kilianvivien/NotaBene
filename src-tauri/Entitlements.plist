<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- An ad-hoc signature has no Team ID. On current macOS, hardened-runtime
       library validation therefore cannot consider separately signed dylibs
       to be from the same team, even though they are sealed inside this app.
       Keep hardened runtime enabled and relax only this one check. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
