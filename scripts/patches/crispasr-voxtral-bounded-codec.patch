+// The upstream whole-utterance graph allocates dense attention tensors whose
+// size is quadratic in the generated duration. Decode fixed windows with the
+// same 25-frame left context used by the production vLLM-Omni Voxtral path.
+// Voxtral emits 12.5 semantic frames/s and the causal decoder expands each
+// frame to 8 * 240 = 1,920 PCM samples.
+static std::vector<float> vtts_codec_decode(voxtral_tts_context* ctx, const std::vector<int>& codes, int n_frames) {
+    constexpr int kCodesPerFrame = 1 + VTTS_ACOUSTIC_DIM;
+    constexpr int kChunkFrames = 25;
+    constexpr int kLeftContextFrames = 25;
+    constexpr int kSamplesPerFrame = 8 * 240;
+
+    if (n_frames <= 0 || codes.size() != (size_t)n_frames * kCodesPerFrame)
+        return {};
+
+    std::vector<float> pcm;
+    pcm.reserve((size_t)n_frames * kSamplesPerFrame);
+    for (int start = 0; start < n_frames; start += kChunkFrames) {
+        const int end = std::min(start + kChunkFrames, n_frames);
+        const int context_start = std::max(0, start - kLeftContextFrames);
+        const int window_frames = end - context_start;
+        const auto codes_begin = codes.begin() + (size_t)context_start * kCodesPerFrame;
+        const auto codes_end = codes.begin() + (size_t)end * kCodesPerFrame;
+        std::vector<int> window_codes(codes_begin, codes_end);
+        std::vector<float> window_pcm = vtts_codec_decode_window(ctx, window_codes, window_frames);
+        const size_t discard = (size_t)(start - context_start) * kSamplesPerFrame;
+        const size_t keep = (size_t)(end - start) * kSamplesPerFrame;
+        if (window_pcm.size() < discard + keep)
+            return {};
+        pcm.insert(pcm.end(), window_pcm.begin() + discard, window_pcm.begin() + discard + keep);
+    }
+    return pcm;
+}
